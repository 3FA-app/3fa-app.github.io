---
import Base from '../layouts/Base.astro';

// Configured base without its trailing slash, for prefixing internal links.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Not found — 3FA" description="Page not found.">
  <section class="not-found">
    <h1>404</h1>
    <p class="lede">That page doesn't exist.</p>
    <p class="not-found__links">
      <a href={base || '/'}>← Back home</a>
      &nbsp;·&nbsp;
      <a href={`${base}/download`}>Download 3FA</a>
    </p>
  </section>
</Base>

<style>
  .not-found {
    padding: 64px 0;
    text-align: center;
  }

  .not-found__links {
    margin-top: 24px;
  }

  .not-found__links a {
    color: #5d9cff;
  }
</style>
