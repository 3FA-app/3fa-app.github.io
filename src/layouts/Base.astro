---
const {
  title = '3FA — Secure Desktop Authenticator',
  description = '3FA is a native authenticator for your personal accounts and your team. Explore device protection, encrypted synchronization, and account recovery.',
} = Astro.props;

// Canonical URL resolved against the configured `site`.
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://threefa.app').href;

// Configured base without its trailing slash, for prefixing internal links.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" content="#16161c" />
    <meta name="referrer" content="no-referrer" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="3FA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header>
      <a href={base || '/'} class="brand">3FA</a>
      <nav aria-label="Main navigation">
        <a href={`${base}/individuals`}>For individuals</a>
        <a href={`${base}/organizations`}>For organizations</a>
        <a href={`${base}/security`}>Security</a>
        <a href={`${base}/download`}>Download</a>
      </nav>
      <div class="account-links" aria-label="Account sign in">
        <a href="https://user.3fa.pro/user/login">User sign in</a>
        <a class="org-login" href="https://org.3fa.pro/org/login">Org sign in <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer>
      <span>3FA Authenticator</span>
      <span>· Native Rust · Zero-knowledge sync</span>
      <a href={`${base}/security`}>Security and recovery</a>
    </footer>

    <style is:global>
      :root { color-scheme: dark; }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: #16161c; color: #e8eaf0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.55;
      }
      header {
        display: flex; flex-wrap: wrap; gap: 18px; justify-content: space-between; align-items: center;
        padding: 18px 32px; border-bottom: 1px solid #303847;
        position: sticky; top: 0; z-index: 10; background: #16161cf5;
      }
      .brand { font-weight: 700; font-size: 20px; color: #5d9cff; text-decoration: none; }
      nav { display: flex; flex-wrap: wrap; gap: 18px; }
      nav a { color: #c7ccd6; text-decoration: none; }
      nav a:hover { color: #fff; }
      a { color: #a7caff; }
      a:focus-visible, button:focus-visible { outline: 3px solid #c5ef9a; outline-offset: 5px; border-radius: 3px; }
      .account-links { display: flex; gap: 18px; align-items: center; font-size: 14px; }
      .account-links a { text-decoration: none; }
      .org-login { border: 1px solid #5d7090; border-radius: 8px; padding: 8px 12px; }
      .skip-link { position: absolute; top: -60px; left: 16px; z-index: 20; background: #16161c; padding: 12px; }
      .skip-link:focus { top: 10px; }
      main { max-width: 880px; margin: 0 auto; padding: 48px 24px; }
      footer {
        text-align: center; color: #aeb4c2; padding: 32px; font-size: 13px;
        border-top: 1px solid #23232c; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;
      }
      h1 { font-size: clamp(32px, 10vw, 40px); line-height: 1.1; margin: 0 0 16px; }
      h2 { font-size: 24px; margin-top: 48px; }
      .lede { font-size: 19px; color: #c7ccd6; }
      .eyebrow { text-transform: uppercase; letter-spacing: .14em; font-size: 12px; font-weight: 700; color: #bde6a4; }
      .onboarding-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin: 36px 0; }
      .onboarding-step { padding: 24px; border: 1px solid #343e50; border-radius: 14px; background: #1b202b; }
      .onboarding-step h2 { margin-top: 14px; font-size: 20px; }
      .onboarding-step p { color: #c7ccd6; }
      .step-number { color: #bde6a4; font: 600 14px ui-monospace, monospace; }
      .onboarding-action { display: inline-block; background: #c5ef9a; color: #152012; padding: 14px 22px; border-radius: 10px; font-weight: 700; text-decoration: none; }
      .onboarding-note { color: #c7ccd6; border-left: 3px solid #5d9cff; padding-left: 18px; margin-top: 32px; }
      @media (max-width: 760px) { header { padding: 16px 20px; } nav { order: 3; width: 100%; gap: 14px; font-size: 14px; } .onboarding-grid { grid-template-columns: 1fr; } }
    </style>
  </body>
</html>
